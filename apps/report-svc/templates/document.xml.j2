<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
{% macro run(text, bold=false) -%}
<w:r>{% if bold %}<w:rPr><w:b/></w:rPr>{% endif %}
{% for line in (text|printable).split('\n') %}{% if not loop.first %}<w:br/>{% endif %}<w:t xml:space="preserve">{{ line }}</w:t>{% endfor %}</w:r>
{%- endmacro %}
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main"
            xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships">
<w:body>
{% for chapter in chapters %}
  <w:p><w:pPr><w:pStyle w:val="Heading1"/>{% if chapter.section.value == 'appendix' or loop.index == 2 %}<w:pageBreakBefore/>{% endif %}</w:pPr>{{ run(chapter.title) }}</w:p>
  {% for block in chapter.blocks %}
    {% if block.headers is defined %}
    <w:tbl>
      <w:tblPr><w:tblW w:w="5000" w:type="pct"/>
        <w:tblBorders><w:bottom w:val="single" w:color="ACB9C1" w:sz="4"/><w:insideH w:val="single" w:color="ACB9C1" w:sz="4"/></w:tblBorders>
        <w:tblLayout w:type="fixed"/>
      </w:tblPr>
      <w:tblGrid>{% for label in block.headers %}<w:gridCol w:w="{{ 9800 // block.headers|length }}"/>{% endfor %}</w:tblGrid>
      <w:tr><w:trPr><w:tblHeader/></w:trPr>
        {% for label in block.headers %}<w:tc><w:tcPr><w:shd w:val="clear" w:fill="E7EFF1"/></w:tcPr><w:p>{{ run(label, true) }}</w:p></w:tc>{% endfor %}
      </w:tr>
      {% for row in block.rows %}<w:tr>
        {% for cell in row %}<w:tc><w:p>{{ run(cell) }}</w:p></w:tc>{% endfor %}
      </w:tr>{% endfor %}
    </w:tbl>
    {% elif block.style == 'evidence' %}
    <w:p><w:pPr><w:pStyle w:val="Code"/></w:pPr><w:hyperlink r:id="{{ links[block.text] }}">{{ run(block.text) }}</w:hyperlink></w:p>
    {% else %}
    <w:p><w:pPr><w:pStyle w:val="{{ {'body':'Normal','subheading':'Heading2','code':'Code'}[block.style] }}"/></w:pPr>{{ run(block.text) }}</w:p>
    {% endif %}
  {% endfor %}
{% endfor %}
<w:sectPr><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1020" w:right="1020" w:bottom="1134" w:left="1020" w:header="510" w:footer="510" w:gutter="0"/></w:sectPr>
</w:body></w:document>
